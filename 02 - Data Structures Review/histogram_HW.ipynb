   "source": [
    "def histogram(string_list):\n",
    "\n",
    "    histo_dict = dict()\n",
    "\n",
    "    for item in string_list:\n",
    "        if item in histo_dict:\n",
    "            histo_dict[item] += 1\n",
    "        else:\n",
    "            histo_dict[item] = 1\n",
    "    return histo_dict"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1",
   "metadata": {},
   "outputs": [],
   "source": [
    "histogram(['word', 'text', 'word', 'word', 'string'])"
   ]
  }
