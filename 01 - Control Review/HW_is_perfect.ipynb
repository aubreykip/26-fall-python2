   "source": [
    "def is_perfect(input_int):\n",
    "    int_sum = 0\n",
    "    for i in range(1,input_int):\n",
    "        if input_int % i == 0:\n",
    "            int_sum += i\n",
    "    if int_sum == input_int:\n",
    "        return True\n",
    "    else:\n",
    "        return False\n"
   ]
  },
